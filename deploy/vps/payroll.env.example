# Copy to /opt/ocean6-payroll/runtime/payroll.env, chmod 0600 root:root.
# Never commit the filled file.
SITE_NAME=payroll.theocean6.com
SITE_URL=https://payroll.theocean6.com
RUNTIME_DIR=/opt/ocean6-payroll/runtime
BACKUP_DIR=/var/lib/ocean6-payroll-backup
APP_IMAGE_TAG=pilot-3613560
GUNICORN_WORKERS=2
DB_ROOT_PASSWORD=__generate__
DB_PASSWORD=__generate__
REDIS_CACHE_PASSWORD=__generate__
REDIS_QUEUE_PASSWORD=__generate__
ADMIN_PASSWORD=__generate__
INGRESS_NETWORK=ocean6-nextcloud_default
