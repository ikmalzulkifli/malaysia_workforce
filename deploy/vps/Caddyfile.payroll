# Append to /opt/ocean6-nextcloud/runtime/Caddyfile, then reload Caddy.
# Replace __PILOT_ALLOW_CIDR__ with the VERIFIED current operator IP/CIDR
# (check with `curl -s https://ifconfig.me` from the operator machine).
#
# The two internal subnets are required in addition to the public allowance:
# web/worker render payslip PDFs and fetch /assets from the site URL through this
# block, entering on the published port from the Nextcloud ingress network
# (172.30.60.0/24) and running inside payroll_internal (172.30.61.0/24). Without
# them PDF download fails with "wkhtmltopdf ... ContentAccessDenied" (HTTP 417).
# They admit internal workloads only and do not bypass Frappe authentication.
#
# Append IN PLACE (`cat >> file`); `sed -i` replaces the inode and the running
# container keeps serving the old, bind-mounted Caddyfile. Restart Caddy if the
# mount is already stale -- `reload` cannot re-bind it. See README.md.
hr.theocean6.com {
    header Strict-Transport-Security "max-age=15552000"
    @pilot remote_ip __PILOT_ALLOW_CIDR__ 172.30.60.0/24 172.30.61.0/24
    handle @pilot {
        reverse_proxy ocean6-payroll-frontend:8080
    }
    handle {
        respond "Not available" 403
    }
}
